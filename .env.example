# Переменные формы заявок. Настоящие значения живут только в
# Vercel → Settings → Environment Variables и в репозиторий не коммитятся.
#
# Локально: скопировать в .env (он в .gitignore) и подставить свои значения.

# Токен бота от @BotFather.
TELEGRAM_BOT_TOKEN=

# Чат, куда падают заявки. Для группы — со знаком минус, например -1001234567890.
TELEGRAM_CHAT_ID=

# Необязательно. Адрес Telegram Bot API — подменяется только в тестах,
# по умолчанию https://api.telegram.org
# TELEGRAM_API_BASE=
