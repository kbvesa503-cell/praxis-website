---
/*
 * Каркас документа: метаданные, предзагрузка шрифтов, глобальные стили.
 */
import '~/styles/reset.css';
import '~/styles/tokens.css';
import '~/styles/fonts.css';
import '~/styles/base.css';
import '~/styles/motion.css';

import { site } from '~/data/content';

interface Props {
  title?: string;
  description?: string;
}

const { title = site.title, description = site.description } = Astro.props;

/* Единственный источник адреса — Astro.site (см. astro.config.mjs).
   Ни canonical, ни og:url, ни JSON-LD не содержат зашитого домена. */
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const ogImage = new URL('/og-image.png', Astro.site).href;

const orgJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: site.name,
  url: Astro.site?.href,
  logo: new URL('/apple-touch-icon.png', Astro.site).href,
  image: ogImage,
  slogan: site.tagline,
  description: site.description,
};
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="theme-color" content="#FFFFFF" />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:locale" content={site.locale} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={site.ogAlt} />

    {/* Telegram, WhatsApp и VK читают Open Graph; twitter:* нужен X
        и части мессенджеров, которые смотрят только на него. */}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={site.ogAlt} />

    {/* Начертания первого экрана — до того, как браузер дойдёт до CSS. */}
    <link
      rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/commissioner-500-cyrillic.woff2"
    />
    <link
      rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/golos-400-cyrillic.woff2"
    />
    <link
      rel="preload" as="font" type="font/woff2" crossorigin
      href="/fonts/plexmono-400-cyrillic.woff2"
    />

    <script type="application/ld+json" set:html={JSON.stringify(orgJsonLd)} is:inline />

    {/* Включаем начальные состояния анимации до первой отрисовки, иначе
        блоки успеют мигнуть. Если модуль движения не поднялся за 2.5 с,
        класс снимается и страница остаётся полностью видимой. */}
    <script is:inline>
      (function () {
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        var root = document.documentElement;
        root.classList.add('motion');
        setTimeout(function () {
          if (!window.__praxisMotion) root.classList.remove('motion');
        }, 2500);
      })();
    </script>
  </head>

  <body>
    <a class="skip-link" href="#main">К основному содержанию</a>
    <slot />

    <script>
      import '~/scripts/motion.ts';
    </script>
  </body>
</html>
