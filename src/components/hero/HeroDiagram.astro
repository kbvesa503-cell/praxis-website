---
/*
 * Схема первого экрана: переход от текущего ручного процесса
 * через точку изменения к перестроенной логике.
 *
 * Геометрия, координаты и цвета перенесены из утверждённого концепта
 * без единой правки. Добавлены только классы — цели для анимации на
 * следующем этапе. Ничего в этом файле не меняет форму схемы.
 */
import { hero } from '~/data/content';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
const mono = "'IBM Plex Mono', monospace";
---

<div class:list={['hdw', className]}>
  <p class="hdw__cap">{hero.diagram.before}</p>

  <svg
    class="hd"
    width="504"
    height="470"
    viewBox="0 0 504 470"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    role="img"
    aria-labelledby="hd-title hd-desc"
  >
    <title id="hd-title">Схема перестройки процесса</title>
    <desc id="hd-desc">
      Сверху — текущий процесс: цепочка ручных действий с возвратами.
      В середине — точка изменения. Снизу — перестроенный участок:
      прямая последовательность автоматизированных шагов.
    </desc>

    <!-- Текущая схема: ручные действия и возвраты -->
    <text
      class="hd__label hd__label--before"
      x="0" y="14"
      font-family={mono} font-size="11" letter-spacing="1.7" fill="#B5B5B5"
    >{hero.diagram.before}</text>

    <g class="hd__edges" stroke="#B5B5B5" stroke-width="1">
      <path class="hd__edge hd__edge--main" d="M26 66 L108 122 L190 66 L272 136 L354 70 L436 130"></path>
      <path class="hd__edge hd__edge--return" d="M272 136 L190 184"></path>
      <path class="hd__edge hd__edge--return" d="M190 184 L108 122"></path>
    </g>

    <g class="hd__nodes" fill="#B5B5B5">
      <rect x="14" y="54" width="24" height="24"></rect>
      <rect x="96" y="110" width="24" height="24"></rect>
      <rect x="178" y="54" width="24" height="24"></rect>
      <rect x="260" y="124" width="24" height="24"></rect>
      <rect x="342" y="58" width="24" height="24"></rect>
      <rect x="424" y="118" width="24" height="24"></rect>
      <rect x="178" y="172" width="24" height="24"></rect>
    </g>

    <!-- Точка изменения -->
    <g class="hd__pivot-lines" stroke="#52513C" stroke-width="1" stroke-dasharray="4 4">
      <path d="M152 232 L252 332"></path>
      <path d="M252 232 L252 332"></path>
      <path d="M352 232 L252 332"></path>
    </g>

    <rect class="hd__pivot" x="242" y="300" width="20" height="20" fill="#52513C"></rect>

    <text
      class="hd__label hd__label--pivot"
      x="278" y="316"
      font-family={mono} font-size="11" letter-spacing="1.7" fill="#52513C"
    >{hero.diagram.pivot}</text>

    <!-- Новая логика процесса -->
    <rect class="hd__band" x="0" y="346" width="504" height="80" fill="#D8C4A3"></rect>

    <path class="hd__baseline" d="M32 386 L472 386" stroke="#000000" stroke-width="1"></path>

    <g class="hd__after-nodes" fill="#000000">
      <rect x="18" y="372" width="28" height="28"></rect>
      <rect x="164" y="372" width="28" height="28"></rect>
      <rect x="312" y="372" width="28" height="28"></rect>
      <rect x="458" y="372" width="28" height="28"></rect>
    </g>

    <text
      class="hd__label hd__label--after"
      x="0" y="452"
      font-family={mono} font-size="11" letter-spacing="1.7" fill="#000000"
    >{hero.diagram.after}</text>
  </svg>

  <p class="hdw__cap">{hero.diagram.after}</p>
</div>

<style>
  .hdw {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .hd {
    display: block;
    width: var(--diagram-w);
    max-width: 100%;
    height: auto;
  }

  /* На утверждённом холсте подписи живут внутри схемы. */
  .hdw__cap { display: none; }

  /* Ниже ~560 px схема начинает сжиматься, и подписи внутри SVG
     масштабируются вместе с ней до нечитаемого размера. Две внешние
     подписи выносятся в HTML и остаются 11 px при любой ширине;
     подпись точки изменения привязана к схеме и остаётся внутри —
     её кегль компенсируется ступенями, чтобы после масштабирования
     она читалась примерно как на десктопе. */
  @media (max-width: 560px) {
    .hd :global(.hd__label--before),
    .hd :global(.hd__label--after) { display: none; }

    .hdw__cap {
      display: block;
      font-family: var(--font-mono);
      font-size: var(--fs-label);
      line-height: var(--lh-ui);
      letter-spacing: var(--ls-label);
      text-transform: uppercase;
      color: var(--mute);
    }

    .hdw__cap:last-child { color: var(--ink); }

    .hd :global(.hd__label--pivot) { font-size: 12px; }
  }

  @media (max-width: 460px) {
    .hd :global(.hd__label--pivot) { font-size: 14px; }
  }

  @media (max-width: 400px) {
    .hd :global(.hd__label--pivot) { font-size: 17px; }
  }
</style>
