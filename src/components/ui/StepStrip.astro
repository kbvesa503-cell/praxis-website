---
/*
 * Полоса шагов метода в двух исполнениях макета:
 *  rule — пять шагов под первым экраном, разделённые линиями;
 *  bar  — семь шагов в бежевой секции, с чёрной планкой над каждым.
 */
interface Props {
  steps: readonly string[];
  variant?: 'rule' | 'bar';
  /** Номер выделенного шага (для варианта bar). */
  active?: number;
  class?: string;
  [key: string]: unknown;
}

const { steps, variant = 'rule', active, class: className, ...rest } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol
  class:list={['strip', `strip--${variant}`, className]}
  style={`--strip-cols:${steps.length}`}
  {...rest}
>
  {
    steps.map((step, i) => (
      <li class:list={['strip__item', active === i + 1 && 'is-active']}>
        {variant === 'bar' && <span class="strip__bar" aria-hidden="true" />}
        <span class="strip__idx" aria-hidden="true">{pad(i + 1)}</span>
        <span class="strip__title">{step}</span>
      </li>
    ))
  }
</ol>

<style>
  .strip {
    display: grid;
    grid-template-columns: repeat(var(--strip-cols), 1fr);
  }

  .strip__idx {
    font-family: var(--font-mono);
    line-height: var(--lh-ui);
  }

  .strip__title {
    font-family: var(--font-text);
    font-weight: 500;
    line-height: var(--lh-ui);
  }

  .strip__item { min-width: 0; }
  .strip__title { overflow-wrap: break-word; }

  /* ---- Вариант rule ---------------------------------------------------- */
  .strip--rule { gap: 28px; }

  .strip--rule .strip__item {
    display: flex;
    align-items: baseline;
    gap: 12px;
    border-top: var(--rule) solid var(--line);
    padding-top: 12px;
  }

  .strip--rule .strip__item:first-child { border-top-color: var(--line-strong); }

  .strip--rule .strip__idx {
    font-size: var(--fs-label-md);
    letter-spacing: var(--ls-label-tight);
    color: var(--mute);
  }

  .strip--rule .strip__item:first-child .strip__idx { color: var(--olive); }

  .strip--rule .strip__title { font-size: var(--fs-body); }

  @media (max-width: 1023px) {
    .strip--rule {
      grid-template-columns: repeat(3, 1fr);
      gap: 24px 20px;
    }
  }

  @media (max-width: 560px) {
    .strip--rule { grid-template-columns: repeat(2, 1fr); }
  }

  /* «Масштабирование» не помещается в половину узкого экрана. */
  @media (max-width: 400px) {
    .strip--rule { grid-template-columns: minmax(0, 1fr); }
  }

  /* ---- Вариант bar ----------------------------------------------------- */
  .strip--bar { gap: 4px; align-items: stretch; }

  .strip--bar .strip__item {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .strip__bar {
    display: block;
    height: 2px;
    background: var(--ink);
  }

  .strip--bar .strip__idx {
    font-size: var(--fs-label-md);
    color: var(--olive);
  }

  .strip--bar .strip__item.is-active .strip__idx { color: var(--ink); }

  .strip--bar .strip__title { font-size: var(--fs-body-sm); }

  @media (max-width: 1279px) {
    .strip--bar {
      grid-template-columns: repeat(4, 1fr);
      gap: 28px 4px;
    }
  }

  @media (max-width: 767px) {
    .strip--bar { grid-template-columns: repeat(2, 1fr); }
  }
</style>
