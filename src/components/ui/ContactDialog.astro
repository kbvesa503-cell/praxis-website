---
/*
 * Форма заявки. Нативный <dialog>: фокус-ловушка, Esc и подложка
 * достаются от браузера, без библиотек и без своего менеджера фокуса.
 *
 * В утверждённом концепте формы нет — она не добавляет секцию на
 * страницу и не меняет её композицию. Оформление собрано из тех же
 * элементов системы: волосяные линии, mono-метки, пилюля действия.
 * Ни карточек, ни теней, ни скруглённых полей.
 *
 * Ошибка поля живёт рядом с полем и связана с ним через aria-describedby,
 * поэтому скринридер читает её при переходе на поле, а не только в общем
 * статусе внизу.
 */
import SectionLabel from './SectionLabel.astro';
import SectionHeading from './SectionHeading.astro';
import Button from './Button.astro';
import { contactForm } from '~/data/content';

const fields = Object.entries(contactForm.fields) as [
  string,
  { label: string; required: boolean; max: number; multiline?: boolean },
][];

/* Автозаполнение подсказываем там, где браузеру есть что предложить.
   У «какой процесс» такого соответствия нет. */
const autocomplete: Record<string, string> = {
  name: 'name',
  company: 'organization',
  contact: 'tel',
};
---

<dialog class="cdlg" id="contact-dialog" aria-labelledby="cdlg-heading">
  <form class="cdlg__panel" data-contact-form novalidate>
    <button type="button" class="cdlg__close" data-close-contact>
      {contactForm.close}
    </button>

    <div class="cdlg__head">
      <SectionLabel tone="olive">{contactForm.label}</SectionLabel>
      <SectionHeading size="h2" id="cdlg-heading">
        {contactForm.heading}
      </SectionHeading>
      <p class="cdlg__lead">{contactForm.lead}</p>
    </div>

    <div class="cdlg__fields">
      {
        fields.map(([name, field]) => (
          <div class="cdlg__field" data-field={name}>
            <label class="cdlg__label" for={`cdlg-${name}`}>
              {field.label}
              {!field.required && (
                <span class="cdlg__opt">{` · ${contactForm.optionalHint}`}</span>
              )}
            </label>

            {field.multiline ? (
              <textarea
                class="cdlg__input cdlg__input--area"
                id={`cdlg-${name}`}
                name={name}
                rows="3"
                maxlength={field.max}
                aria-describedby={`cdlg-${name}-error`}
              />
            ) : (
              <input
                class="cdlg__input"
                id={`cdlg-${name}`}
                name={name}
                type="text"
                maxlength={field.max}
                autocomplete={autocomplete[name]}
                required={field.required || undefined}
                aria-required={field.required ? 'true' : undefined}
                aria-describedby={`cdlg-${name}-error`}
              />
            )}

            <p class="cdlg__error" id={`cdlg-${name}-error`} data-field-error />
          </div>
        ))
      }
    </div>

    {/* Ловушка для ботов: поле скрыто от людей и от скринридеров.
        Заполнено — заявка не отправляется, но отвечаем как при успехе. */}
    <div class="cdlg__trap" aria-hidden="true">
      <label for="cdlg-company-website">Не заполняйте это поле</label>
      <input
        id="cdlg-company-website"
        type="text"
        name="company_website"
        tabindex="-1"
        autocomplete="off"
      />
    </div>

    <div class="cdlg__foot">
      <Button type="submit" data-contact-submit>{contactForm.submit}</Button>
      <p class="cdlg__status" role="status" aria-live="polite" data-contact-status></p>
    </div>
  </form>
</dialog>

<style>
  .cdlg {
    width: min(520px, calc(100vw - 32px));
    max-height: calc(100vh - 32px);
    max-height: calc(100dvh - 32px);
    padding: 0;
    border: var(--rule) solid var(--ink);
    background: var(--paper);
    color: var(--ink);
  }

  .cdlg::backdrop {
    background: rgb(0 0 0 / 0.6);
  }

  .cdlg__panel {
    display: flex;
    flex-direction: column;
    gap: 32px;
    max-height: calc(100vh - 32px);
    max-height: calc(100dvh - 32px);
    overflow-y: auto;
    padding: clamp(28px, 4vw, 44px);
  }

  .cdlg__close {
    position: absolute;
    top: 18px;
    right: 20px;
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-meta);
    transition: color var(--dur-fast) var(--ease);
  }

  .cdlg__close:hover { color: var(--ink); }

  .cdlg__head {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }

  .cdlg__lead {
    font-size: var(--fs-body-sm);
    line-height: var(--lh-text);
    color: var(--text-quiet);
  }

  .cdlg__fields {
    display: flex;
    flex-direction: column;
  }

  .cdlg__field {
    display: flex;
    flex-direction: column;
    gap: 6px;
    border-top: var(--rule) solid var(--line);
    padding: 16px 0;
  }

  .cdlg__field:first-child { border-top-color: var(--line-strong); }
  .cdlg__field:last-child { border-bottom: var(--rule) solid var(--line); }

  .cdlg__label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
    color: var(--text-meta);
  }

  /* Необязательность — часть метки, а не отдельная подпись:
     иначе в форме из четырёх полей появляется пятый уровень текста. */
  .cdlg__opt { color: var(--text-label); }

  .cdlg__input {
    width: 100%;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-ui);
    color: var(--ink);
    padding: 2px 0;
  }

  .cdlg__input--area {
    resize: vertical;
    min-height: 66px;
  }

  /* Поле с ошибкой: линия под ним темнеет до оливы, метка тоже.
     Ни красного, ни иконок — шестого цвета в системе нет. */
  .cdlg__field[data-invalid] { border-top-color: var(--olive); }
  .cdlg__field[data-invalid] + .cdlg__field { border-top-color: var(--olive); }
  .cdlg__field[data-invalid]:last-child { border-bottom-color: var(--olive); }
  .cdlg__field[data-invalid] .cdlg__label { color: var(--olive); }

  .cdlg__error {
    font-size: var(--fs-caption);
    line-height: var(--lh-ui);
    color: var(--olive);
  }

  .cdlg__error:empty { display: none; }

  .cdlg__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .cdlg__foot {
    display: flex;
    align-items: center;
    gap: 20px;
    flex-wrap: wrap;
  }

  .cdlg__status {
    font-size: var(--fs-ui);
    line-height: var(--lh-ui);
    color: var(--text-quiet);
  }

  .cdlg__status:empty { display: none; }

  .cdlg[data-state='error'] .cdlg__status { color: var(--olive); }

  /* Кнопка на время запроса перестаёт быть кликабельной и выглядит так же. */
  .cdlg__foot :global(.btn[disabled]) {
    opacity: 0.55;
    cursor: default;
  }

  @media (prefers-reduced-motion: reduce) {
    .cdlg__close { transition: none; }
  }
</style>

<script>
  import '~/scripts/contact.ts';
</script>
