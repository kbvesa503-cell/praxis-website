---
/*
 * Список результатов с крупными цифрами Commissioner (секция 01).
 * Первый пункт задаёт масштаб: чёрная линия, чёрная цифра 40 px,
 * заголовок 22 px. Остальные идут на ступень тише.
 */
import type { IndexedItem } from '~/data/content';

interface Props {
  items: IndexedItem[];
  class?: string;
  [key: string]: unknown;
}

const { items, class: className, ...rest } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---

<ol class:list={['rlist', className]} {...rest}>
  {
    items.map((item, i) => (
      <li class="rlist__row">
        <span class="rlist__num" aria-hidden="true">{pad(i + 1)}</span>
        <div class="rlist__body">
          <span class="rlist__title">{item.title}</span>
          {item.description && <span class="rlist__desc">{item.description}</span>}
        </div>
      </li>
    ))
  }
</ol>

<style>
  .rlist {
    display: flex;
    flex-direction: column;
  }

  .rlist__row {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 24px;
    align-items: baseline;
    border-top: var(--rule) solid var(--line);
    padding-block: 22px;
  }

  .rlist__row:first-child {
    border-top-color: var(--line-strong);
    padding-block: 26px;
  }

  .rlist__row:last-child { border-bottom: var(--rule) solid var(--line); }

  .rlist__num {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-num-md);
    letter-spacing: var(--ls-num);
    line-height: 1;
    color: var(--olive);
  }

  .rlist__row:first-child .rlist__num {
    font-size: var(--fs-num-lg);
    color: var(--ink);
  }

  .rlist__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .rlist__title {
    font-family: var(--font-text);
    font-weight: 500;
    font-size: 19px;
    line-height: var(--lh-ui);
  }

  .rlist__row:first-child .rlist__title { font-size: 22px; }

  @media (max-width: 767px) {
    .rlist__row {
      grid-template-columns: 44px 1fr;
      gap: 16px;
    }
  }

  .rlist__desc {
    font-size: var(--fs-ui);
    line-height: var(--lh-ui);
    color: var(--text-quiet);
  }
</style>
