---
/*
 * Служебная метка секции: IBM Plex Mono, капитель, широкий трекинг.
 * Встречается в макете восемь раз.
 *
 * Тон по умолчанию — meta, а не mute: метка секции несёт номер и тему
 * раздела, её читают. Тон mute оставлен для меток, которые ничего
 * не значат в отрыве от соседнего элемента.
 */
interface Props {
  tone?: 'meta' | 'mute' | 'olive' | 'sand' | 'ink';
  size?: 'sm' | 'md';
  as?: 'span' | 'h2' | 'p';
  id?: string;
  class?: string;
}

const { tone = 'meta', size = 'sm', as: Tag = 'span', id, class: className }: Props =
  Astro.props;
---

<Tag id={id} class:list={['label', `label--${tone}`, `label--${size}`, className]}>
  <slot />
</Tag>

<style>
  .label {
    display: block;
    font-family: var(--font-mono);
    font-weight: 400;
    line-height: var(--lh-ui);
    letter-spacing: var(--ls-label);
    text-transform: uppercase;
  }

  .label--sm { font-size: var(--fs-label); }
  .label--md { font-size: var(--fs-label-lg); }

  .label--meta { color: var(--text-meta); }
  .label--mute { color: var(--text-label); }
  .label--olive { color: var(--olive); }
  .label--sand { color: var(--sand); }
  .label--ink { color: var(--ink); }
</style>
