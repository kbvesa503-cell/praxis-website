---
/*
 * Сноска под блоком: оговорка о характере цифр или статусе раздела.
 */
interface Props {
  rule?: boolean;
  class?: string;
  [key: string]: unknown;
}

const { rule = true, class: className, ...rest } = Astro.props;
---

<p class:list={['disclaimer', rule && 'disclaimer--rule', className]} {...rest}>
  <slot />
</p>

<style>
  .disclaimer {
    max-width: 780px;
    font-size: var(--fs-ui);
    line-height: var(--lh-text);
    color: var(--text-quiet);
  }

  .disclaimer--rule {
    border-top: var(--rule) solid var(--line);
    padding-top: 22px;
  }
</style>
