---
/*
 * Ряд показателей: метка → крупная цифра → подпись.
 * Используется дважды: логика экономического эффекта (секция 03)
 * и предварительные показатели кейса (секция 06).
 */
import type { MetricItem } from '~/data/content';

interface Props {
  metrics: readonly MetricItem[];
  class?: string;
  [key: string]: unknown;
}

const { metrics, class: className, ...rest } = Astro.props;
---

<dl
  class:list={['metrics', className]}
  style={`--metrics-cols:${metrics.length}`}
  {...rest}
>
  {
    metrics.map((m) => (
      <div class:list={['metric', m.accent && 'is-accent']}>
        <dt class="metric__label">{m.label}</dt>
        <dd class="metric__value">{m.value}</dd>
        {m.caption && <dd class="metric__caption">{m.caption}</dd>}
      </div>
    ))
  }
</dl>

<style>
  .metrics {
    display: grid;
    grid-template-columns: repeat(var(--metrics-cols), 1fr);
  }

  .metric {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .metric__label {
    font-family: var(--font-mono);
    font-size: var(--fs-label);
    line-height: var(--lh-ui);
    letter-spacing: var(--ls-label-mid);
    text-transform: uppercase;
    color: var(--text-meta);
  }

  .metric.is-accent .metric__label { color: var(--olive); }

  .metric__value {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 500;
    letter-spacing: var(--ls-num);
    line-height: 1;
    color: var(--ink);
  }

  .metric.is-accent .metric__value { color: var(--olive); }

  .metric__caption {
    margin: 0;
    font-size: var(--fs-ui);
    line-height: 1.4;
    color: var(--text-quiet);
  }

  .metrics { border-top: var(--rule) solid var(--line-strong); }

  .metrics .metric {
    padding: 26px 24px 0;
    border-right: var(--rule) solid var(--line);
  }

  .metrics .metric:first-child { padding-left: 0; }
  .metrics .metric:last-child { padding-right: 0; border-right: 0; }

  .metrics .metric__value { font-size: var(--fs-num-lg); }

  /* При переносе в две колонки и в одну вертикальные разделители
     превращаются в горизонтальные: линия между ячейками остаётся
     всегда, меняется только её направление. */
  @media (min-width: 600px) and (max-width: 1023px) {
    .metrics { grid-template-columns: repeat(2, 1fr); }

    .metrics .metric { padding: 26px 24px; }
    .metrics .metric:nth-child(odd) {
      padding-left: 0;
      border-right: var(--rule) solid var(--line);
    }
    .metrics .metric:nth-child(even) {
      padding-right: 0;
      border-right: 0;
    }
    .metrics .metric:nth-child(n + 3) { border-top: var(--rule) solid var(--line); }
    .metrics .metric:nth-last-child(-n + 2) { padding-bottom: 0; }
  }

  @media (max-width: 599px) {
    .metrics { grid-template-columns: minmax(0, 1fr); }

    .metrics .metric {
      padding: 24px 0;
      border-right: 0;
    }
    .metrics .metric:not(:first-child) { border-top: var(--rule) solid var(--line); }
    .metrics .metric:last-child { padding-bottom: 0; }
  }
</style>
