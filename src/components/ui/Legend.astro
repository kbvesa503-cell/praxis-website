---
/*
 * Легенда к схеме первого экрана: четыре образца с подписями.
 * Образец повторяет способ отрисовки шага в схеме — контур или заливка,
 * поэтому расхождения между легендой и графикой быть не может.
 */
import type { LegendItem } from '~/data/content';

interface Props {
  items: readonly LegendItem[];
  class?: string;
}

const { items, class: className } = Astro.props;
---

<ul class:list={['legend', className]}>
  {
    items.map((item) => (
      <li class="legend__item">
        <span
          class:list={[
            'legend__swatch',
            `legend__swatch--${item.color}`,
            item.outline && 'legend__swatch--outline',
          ]}
          aria-hidden="true"
        />
        <span class="legend__label">{item.label}</span>
      </li>
    ))
  }
</ul>

<style>
  .legend {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 24px;
    border-top: var(--rule) solid var(--line);
    padding-top: 18px;
  }

  .legend__item {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .legend__swatch {
    flex: none;
    width: 12px;
    height: 12px;
  }

  .legend__swatch--mute { background: var(--mute); }
  .legend__swatch--olive { background: var(--olive); }
  .legend__swatch--sand { background: var(--sand); }
  .legend__swatch--ink { background: var(--ink); }

  /* Контур вместо заливки — как обычный шаг процесса в схеме. */
  .legend__swatch--outline {
    background: var(--paper);
    box-shadow: inset 0 0 0 var(--rule) var(--mute);
  }

  .legend__label {
    font-size: var(--fs-label-lg);
    line-height: var(--lh-ui);
    color: var(--text);
  }

  @media (max-width: 479px) {
    .legend { grid-template-columns: minmax(0, 1fr); }
  }
</style>
