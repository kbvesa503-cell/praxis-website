---
/* Секция 02 — как работает PRAXIS. Бежевая секция-пауза. */
import Section from '~/components/ui/Section.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import StepStrip from '~/components/ui/StepStrip.astro';
import { howItWorks } from '~/data/content';
---

<Section id="how" tone="sand" labelledby="how-heading">
  <div class="how">
    <div class="how__head">
      <SectionLabel tone="olive">{howItWorks.label}</SectionLabel>
      <SectionHeading size="h2" id="how-heading">{howItWorks.heading}</SectionHeading>
    </div>

    <StepStrip steps={howItWorks.steps} variant="bar" active={howItWorks.activeStep} />
  </div>
</Section>

<style>
  .how {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  .how__head {
    display: flex;
    flex-direction: column;
    gap: 18px;
    max-width: 640px;
  }
</style>
