---
/* Финальный призыв на чёрном фоне. */
import Section from '~/components/ui/Section.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import CtaButton from '~/components/ui/CtaButton.astro';
import { finalCta } from '~/data/content';
---

<Section id="contact" tone="ink" pt="110px" pb="110px" labelledby="cta-heading">
  <div class="cta" data-reveal>
    <SectionLabel tone="sand">{finalCta.label}</SectionLabel>
    <SectionHeading size="h2-cta" tone="paper" id="cta-heading" measure={780}>
      {finalCta.heading}
    </SectionHeading>
    <CtaButton variant="onDark" place="final_cta" fallbackHref="#first-step">{finalCta.cta}</CtaButton>
  </div>
</Section>

<style>
  .cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 34px;
  }
</style>
