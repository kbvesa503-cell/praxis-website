---
/*
 * Первый экран: обещание слева, схема перестройки процесса справа.
 */
import Section from '~/components/ui/Section.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import CtaButton from '~/components/ui/CtaButton.astro';
import QuietLink from '~/components/ui/QuietLink.astro';
import Legend from '~/components/ui/Legend.astro';
import HeroDiagram from '~/components/hero/HeroDiagram.astro';
import { hero } from '~/data/content';
---

<Section rule="none" pt="100px" pb="72px" class="hero" labelledby="hero-heading">
  <div class="hero__grid">
    <div class="hero__copy">
      <SectionLabel tone="olive" size="md">{hero.eyebrow}</SectionLabel>

      <SectionHeading as="h1" size="h1" id="hero-heading">
        {
          hero.headingLines.map((line, i) => (
            <>
              {/* Пробел стоит перед переносом: на холсте 1440 он схлопывается
                  в конце строки, а когда перенос скрыт — разделяет слова. */}
              {i > 0 && <>{' '}<br class="hero__br" /></>}
              {line}
            </>
          ))
        }
      </SectionHeading>

      <p class="hero__lead">{hero.lead}</p>

      <div class="hero__actions">
        <CtaButton place="hero">{hero.cta}</CtaButton>
        <QuietLink href="#economics">{hero.secondaryCta}</QuietLink>
      </div>
    </div>

    <div class="hero__figure">
      <HeroDiagram />
      <Legend items={hero.legend} />
    </div>
  </div>
</Section>

<style>
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 580px;
    gap: 68px;
  }

  .hero__copy {
    display: flex;
    flex-direction: column;
    gap: 38px;
  }

  .hero__lead {
    max-width: 520px;
    font-size: var(--fs-lead);
    line-height: var(--lh-text);
  }

  .hero__actions {
    display: flex;
    align-items: center;
    gap: 30px;
    margin-top: 6px;
  }

  .hero__figure {
    display: flex;
    flex-direction: column;
    gap: 26px;
    border-left: var(--rule) solid var(--line);
    padding-left: 60px;
  }

  /* Ниже 1440 колонка схемы перестаёт быть фиксированной,
     ручные переносы заголовка снимаются. */
  @media (max-width: 1439px) {
    .hero__br { display: none; }

    .hero__grid {
      grid-template-columns: minmax(0, 1fr) minmax(0, var(--diagram-w));
      gap: clamp(36px, 4.722vw, 68px);
    }

    .hero__figure { padding-left: clamp(28px, 4.167vw, 60px); }
  }

  /* Планшет и ниже: одна колонка. Левая граница колонки схемы
     становится верхней линией — линия остаётся, характер не меняется. */
  @media (max-width: 1023px) {
    .hero__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 48px;
    }

    .hero__copy { gap: 30px; }

    .hero__figure {
      border-left: 0;
      border-top: var(--rule) solid var(--line);
      padding-left: 0;
      padding-top: 36px;
    }
  }

  @media (max-width: 560px) {
    .hero__actions {
      flex-wrap: wrap;
      gap: 22px;
    }
  }
</style>
