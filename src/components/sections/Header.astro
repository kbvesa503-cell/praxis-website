---
/*
 * Шапка: lockup слева, навигация и основное действие справа.
 * Оливковый в шапке используется только как квадрат знака —
 * в тексте и интерфейсе его нет (Brand Core 08).
 */
import Lockup from '~/components/brand/Lockup.astro';
import Nav from '~/components/ui/Nav.astro';
import CtaButton from '~/components/ui/CtaButton.astro';
import { nav, hero } from '~/data/content';
---

<header class="header" data-header>
  <div class="header__inner">
    <a class="header__brand" href="#top" aria-label="PRAXIS — на главную">
      <Lockup markHeight={29} fontSize={20} />
    </a>

    <nav class="header__nav" aria-label="Основная навигация">
      <Nav links={nav} />
      <CtaButton size="sm" place="header">{hero.cta}</CtaButton>
    </nav>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: var(--rule) solid var(--line);
    background: var(--paper);
    transition: transform var(--dur) var(--ease);
  }

  /* Уезжает при прокрутке вперёд, возвращается при движении вверх.
     Ни тени, ни размытия, ни сжатия — шапка просто есть или её нет. */
  .header.is-hidden { transform: translateY(-100%); }

  @media (prefers-reduced-motion: reduce) {
    .header { transition: none; }
  }

  .header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    max-width: var(--page-max);
    margin-inline: auto;
    padding: var(--header-py) var(--gutter);
  }

  .header__brand { display: inline-flex; }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 30px;
  }

  /* При трёх пунктах бургер-меню — лишняя механика:
     ссылки уходят, основное действие остаётся на виду. */
  @media (max-width: 767px) {
    .header__nav :global(.nav) { display: none; }
  }

  /* Тач-цель кнопки — не меньше 44 px. */
  @media (hover: none) {
    .header__nav :global(.btn) { min-height: 44px; }
  }

  @media (max-width: 479px) {
    .header__inner { gap: 12px; }

    /* Знак остаётся выше минимума Brand Core (16 px знак / 19 px lockup). */
    .header__brand :global(.lockup) {
      --lockup-fs: 17px;
      --lockup-gap: 9px;
    }

    .header__brand :global(svg) {
      height: 25px;
      width: auto;
    }

    .header__nav :global(.btn--sm) {
      font-size: var(--fs-caption);
      padding: 10px 16px;
    }
  }

  @media (max-width: 359px) {
    .header__nav :global(.btn--sm) {
      font-size: var(--fs-label-lg);
      padding: 10px 14px;
    }
  }
</style>
