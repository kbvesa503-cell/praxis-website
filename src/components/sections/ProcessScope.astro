---
/*
 * Секция 04 — какие процессы имеет смысл пересматривать.
 *
 * Ритм секции пересобран: сетка неравная (аside уже, список шире),
 * колонки списка тоже разной ширины, а сам аside на десктопе стоит
 * на месте, пока список едет мимо. Движение берётся из композиции,
 * а не из добавленной графики.
 */
import Section from '~/components/ui/Section.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import IndexedList from '~/components/ui/IndexedList.astro';
import { processScope } from '~/data/content';

/* Две колонки макета: 01–04 и 05–07, нумерация сквозная. */
const left = processScope.items.slice(0, 4);
const right = processScope.items.slice(4);
---

<Section id="processes" density="tight" labelledby="processes-heading">
  <div class="split">
    <div class="split__aside" data-reveal>
      <SectionLabel>{processScope.label}</SectionLabel>
      <SectionHeading size="h2-lg" id="processes-heading">{processScope.heading}</SectionHeading>
      <p class="split__lead">{processScope.lead}</p>
    </div>

    <div class="split__columns">
      <IndexedList items={left} start={1} size="md" lead data-reveal data-reveal-rows />
      <IndexedList items={right} start={5} size="md" data-reveal data-reveal-rows style="--reveal-i:1" />
    </div>
  </div>
</Section>

<style>
  .split {
    display: grid;
    grid-template-columns: 0.62fr 1fr;
    gap: 52px;
    align-items: start;
  }

  .split__aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .split__lead {
    max-width: 340px;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-text);
    color: var(--text-quiet);
  }

  /* Колонки списка неравные: первая несёт крупную ведущую строку,
     вторая идёт тише. Это и даёт секции контраст масштаба. */
  .split__columns {
    display: grid;
    grid-template-columns: 1.12fr 0.88fr;
    column-gap: 44px;
  }

  /* Пока список едет мимо, заголовок секции стоит: длинная полоса
     перестаёт читаться как ещё один одинаковый экран. */
  @media (min-width: 1024px) {
    .split__aside {
      position: sticky;
      top: 132px;
    }
  }

  @media (max-width: 1023px) {
    .split {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }

    .split__lead { max-width: 560px; }
    .split__columns { grid-template-columns: 1fr 1fr; }
  }

  /* Ниже 768 две колонки сливаются в один список.
     Сквозная нумерация 01–07 сохраняется. */
  @media (max-width: 767px) {
    .split__columns { grid-template-columns: minmax(0, 1fr); }
  }
</style>
