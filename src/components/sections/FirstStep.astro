---
/*
 * Секция 05 — первый шаг: один процесс или отдел, а не вся компания.
 *
 * Сетка намеренно неравная и со сдвигом по вертикали: список начинается
 * ниже заголовка, а не вровень с ним. После плотных секций 03–04 это
 * возвращает странице движение, не добавляя ни одного лишнего элемента.
 */
import Section from '~/components/ui/Section.astro';
import SectionLabel from '~/components/ui/SectionLabel.astro';
import SectionHeading from '~/components/ui/SectionHeading.astro';
import IndexedList from '~/components/ui/IndexedList.astro';
import CtaButton from '~/components/ui/CtaButton.astro';
import { firstStep } from '~/data/content';
---

<Section id="first-step" density="tight" pb="86px" labelledby="first-step-heading">
  <div class="fstep">
    <div class="fstep__aside" data-reveal>
      <SectionLabel>{firstStep.label}</SectionLabel>
      <SectionHeading size="h2-lg" id="first-step-heading">{firstStep.heading}</SectionHeading>
      <p class="fstep__lead">{firstStep.lead}</p>
      <div class="fstep__action">
        <CtaButton>{firstStep.cta}</CtaButton>
      </div>
    </div>

    <IndexedList
      items={firstStep.items}
      size="sm"
      lead
      offset
      data-reveal
      data-reveal-rows
      style="--reveal-i:1"
    />
  </div>
</Section>

<style>
  .fstep {
    display: grid;
    grid-template-columns: 0.82fr 1fr;
    gap: 56px;
    align-items: start;
  }

  .fstep__aside {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .fstep__lead {
    max-width: 400px;
    font-size: var(--fs-body-sm);
    line-height: var(--lh-text);
    color: var(--text-quiet);
  }

  .fstep__action { margin-top: 12px; }

  @media (max-width: 1023px) {
    .fstep {
      grid-template-columns: minmax(0, 1fr);
      gap: 36px;
    }

    .fstep__lead { max-width: 560px; }
  }
</style>
